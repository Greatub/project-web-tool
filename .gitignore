# Public repository is an explicit allowlist. Original cases remain local.
/*
!/.gitignore
!/README.md
!/package.json
!/src/
/src/*
!/src/index.html
!/docs/
/docs/*
!/docs/PUBLIC.md
!/docs/STATUS.md
!/scripts/
/scripts/*
!/scripts/privacy-check.cjs
!/scripts/release.cjs
!/tests/
/tests/*
!/tests/public/
/tests/public/*
!/tests/public/core.cjs
!/tests/public/excel.cjs
!/.githooks/
/.githooks/*
!/.githooks/pre-commit
!/.githooks/pre-push
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/check.yml
