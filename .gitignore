# Public repository is an explicit allowlist. Original cases remain local.
/*
!/.gitignore
!/README.md
!/package.json
!/src/
/src/*
!/src/index.html
!/src/app/
/src/app/*
!/src/app/shell.html
!/src/app/styles.css
!/src/app/js/
/src/app/js/*
!/src/app/js/i18n.js
!/src/app/js/model.js
!/src/app/js/storage.js
!/src/app/js/dialogs.js
!/src/app/js/exchange.js
!/src/app/js/views.js
!/src/app/js/history.js
!/src/app/js/editing.js
!/src/app/js/boot.js
!/docs/
/docs/*
!/docs/PUBLIC.md
!/docs/STATUS.md
!/scripts/
/scripts/*
!/scripts/build.cjs
!/scripts/privacy-check.cjs
!/scripts/release.cjs
!/tests/
/tests/*
!/tests/public/
/tests/public/*
!/tests/public/core.cjs
!/tests/public/excel.cjs
!/tests/public/storage.cjs
!/tests/public/workflow.cjs
!/tests/public/project.cjs
!/tests/e2e/
/tests/e2e/*
!/tests/e2e/smoke.cjs
!/.githooks/
/.githooks/*
!/.githooks/pre-commit
!/.githooks/pre-push
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/check.yml
